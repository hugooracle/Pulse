    <string name="reverb_help_title">Predefinições de reverberação</string>
    <string name="reverb_help_intro">Cada predefinição simula um espaço com parâmetros próprios e volume normalizado, para que a mudança altere o ambiente e não o nível sonoro.</string>
    <string name="reverb_help_rt60">Cauda (RT60): %1$s</string>
    <string name="reverb_help_predelay">Pré-atraso: %1$s</string>
    <string name="reverb_help_damping">Amortecimento a partir de: %1$s</string>
    <string name="reverb_help_room">Pequena e controlada. Acrescenta espaço sem tornar o som difuso.</string>
    <string name="reverb_help_hall">Um auditório. Longo mas nítido, adequado ao efeito de reverberação prolongada.</string>
    <string name="reverb_help_plate">Uma placa de estúdio. Brilhante e densa, funciona bem com vozes.</string>
    <string name="reverb_help_cathedral">Uma catedral. Muito longa e escura, com uma cauda extensa.</string>
    <string name="reverb_help_rt60_meaning">RT60 é o tempo que a cauda demora a diminuir 60 dB e traduz a dimensão aparente do espaço.</string>
    <string name="reverb_help_predelay_meaning">O pré-atraso é o silêncio antes de começar a reverberação. Um intervalo maior mantém o som direto mais nítido.</string>
    <string name="reverb_help_damping_meaning">O amortecimento define a partir de que ponto a cauda perde agudos, simulando a absorção do ar e das superfícies.</string>
    <string name="reverb_help_mix">A mistura define a proporção entre o sinal com reverberação e o sinal direto.</string>
